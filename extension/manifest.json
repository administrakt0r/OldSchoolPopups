{
  "manifest_version": 3,
  "name": "RetroPop 98 - 90s Web Nostalgia Popups",
  "short_name": "RetroPop 98",
  "version": "1.0.0",
  "description": "Relive the chaotic golden age of the 1990s web! Injects hilarious, harmless Windows 98 fake popups on any webpage.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "RetroPop 98 Controls",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}